#!/bin/bash
#-----------------------------------------------------------------------------------------------------------------------------------------------------------#
#title           :deb_package.sh                                                                                                                          #
#description     :This script attempts to backup your installed packages as .deb files for future use or downgrade purposes.                                  #
#author          :Generated by ChatGPT                                                                                                                       #
#date            :$(date +%Y%m%d)                                                                                                                            #
#version         :1.0                                                                                                                                       #
#depends         :dpkg, awk, sed, bash                                                                                                                      #
#usage           :./deb_package.sh                                                                                                                        #
#-----------------------------------------------------------------------------------------------------------------------------------------------------------#

# Text color variables
txtund=$(tput sgr 0 1)            # Underline
txtbld=$(tput bold)               # Bold
bldred=${txtbld}$(tput setaf 1)   # Bold red
bldblu=${txtbld}$(tput setaf 4)   # Bold blue
txtrst=$(tput sgr0)               # Reset

# Feedback messages
info="${bldblu}*${txtrst}"        # Info message
warn="${bldred}*${txtrst}"        # Warning message

# Functions
function usage() {
    echo -e "${warn} No valid package ID provided. Do you want to list all installed packages? (y/n): \c"
    read listPackages
    case "$listPackages" in
        y|Y)
            list_installed_packages
            ;;
        n|N)
            echo -e "${warn} Exiting... Please provide a valid package ID."
            exit 1
            ;;
        *)
            echo -e "${warn} Invalid choice. Exiting."
            exit 1
            ;;
    esac
}

function list_installed_packages() {
    # List installed packages
    echo -e "${info} Fetching installed packages..."
    dpkg --get-selections | awk '{print NR ": " $1}' > /tmp/package_list.txt
    cat /tmp/package_list.txt
    echo -e "${info} Please enter the package number from the list: \c"
    read package_number
    package_name=$(awk -v num="$package_number" 'NR == num {print $2}' /tmp/package_list.txt)
    if [ -z "$package_name" ]; then
        echo -e "${warn} Invalid package number."
        exit 1
    fi
    echo -e "${info} You selected package: ${package_name}"
    BUNDLEID="$package_name"
}

function check_directory() {
    # Check if directory exists, otherwise create it
    local dir_path=$1
    if [ ! -d "$dir_path" ]; then
        echo -e "${info} Directory $dir_path does not exist. Creating it..."
        mkdir -p "$dir_path"
    else
        echo -e "${info} Directory $dir_path exists. Continuing..."
    fi
}

# Main logic starts here

# Check if the user provided a package ID
if [ -z "$1" ]; then
    usage
else
    BUNDLEID="$1"
fi

# Define directories
REPACK_DIR="/var/mobile/Documents/Debfile"
PACKAGE_DIR="$REPACK_DIR/packages/$BUNDLEID"
DEBS_DIR="$REPACK_DIR/debs"
LOG_FILE="$REPACK_DIR/repack.log"
ERROR_FILE="$REPACK_DIR/repack.err"

# Create necessary directories
check_directory "$REPACK_DIR"
check_directory "$PACKAGE_DIR"
check_directory "$PACKAGE_DIR/DEBIAN"
check_directory "$DEBS_DIR"

# Logging
exec > >(tee -a "$LOG_FILE")
exec 2> >(tee -a "$ERROR_FILE" >&2)

# Extract package info
echo -e "${info} Fetching package information for $BUNDLEID..."
VERSION=$(dpkg-query -W -f='${Version}' "$BUNDLEID")
ARCHITECTURE=$(dpkg-query -W -f='${Architecture}' "$BUNDLEID")
DEB_FILE="$BUNDLEID"_"$VERSION"_"$ARCHITECTURE".deb

# Create the control file in the DEBIAN folder
echo -e "${info} Creating control file for $BUNDLEID..."
dpkg-query -s "$BUNDLEID" | grep -v Status > "$PACKAGE_DIR/DEBIAN/control"

# Copy package files to the package directory
echo -e "${info} Copying files for $BUNDLEID..."
dpkg-query -L "$BUNDLEID" | while read -r file; do
    if [ -d "$file" ]; then
        mkdir -p "$PACKAGE_DIR$file"
    elif [ -f "$file" ]; then
        cp -p "$file" "$PACKAGE_DIR$file"
    fi
done

# Repackage the .deb file
echo -e "${info} Repacking $BUNDLEID as a .deb file..."
dpkg-deb -bZgzip "$PACKAGE_DIR" "$DEBS_DIR/$DEB_FILE"

# Cleanup
echo -e "${info} Cleaning up..."
rm -rf "$PACKAGE_DIR"

# Finish
echo -e "${info} Repackaging completed. The new .deb file is located at: $DEBS_DIR/$DEB_FILE"
